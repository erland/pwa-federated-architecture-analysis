{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metamodel-builder.local/schemas/mmp-conformance-declaration-v1.schema.json",
  "title": "MMP conformance declaration v1 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "declaration_version",
    "implementation",
    "package_format_versions",
    "profiles"
  ],
  "properties": {
    "declaration_version": {
      "const": "1.0.0"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["consumer", "producer", "both"]
        }
      }
    },
    "package_format_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mmp-core", "mmp-rules", "mmp-notation", "mmp-viewpoints"],
      "properties": {
        "mmp-core": {
          "$ref": "#/$defs/profile"
        },
        "mmp-rules": {
          "$ref": "#/$defs/profile"
        },
        "mmp-notation": {
          "$ref": "#/$defs/profile"
        },
        "mmp-viewpoints": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "rule_languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["supported", "partial", "unsupported"]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["limitations"]
          }
        }
      ]
    }
  }
}
