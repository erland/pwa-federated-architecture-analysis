{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metamodel-builder.local/schemas/properties.schema.json",
  "title": "Canonical properties v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_types",
    "enumerations",
    "property_definitions",
    "property_sets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "data_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "base"],
        "properties": {
          "id": {
            "$ref": "common-definitions.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common-definitions.schema.json#/$defs/nonEmpty"
          },
          "base": {
            "enum": [
              "string",
              "integer",
              "decimal",
              "boolean",
              "date",
              "datetime",
              "uri",
              "identifier"
            ]
          },
          "description": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "extensions": {
            "$ref": "common-definitions.schema.json#/$defs/extensions"
          }
        }
      }
    },
    "enumerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "values"],
        "properties": {
          "id": {
            "$ref": "common-definitions.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common-definitions.schema.json#/$defs/nonEmpty"
          },
          "description": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "$ref": "common-definitions.schema.json#/$defs/id"
                },
                "name": {
                  "$ref": "common-definitions.schema.json#/$defs/nonEmpty"
                },
                "description": {
                  "type": "string"
                },
                "deprecated": {
                  "type": "boolean"
                }
              }
            }
          },
          "extensions": {
            "$ref": "common-definitions.schema.json#/$defs/extensions"
          }
        }
      }
    },
    "property_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type"],
        "properties": {
          "id": {
            "$ref": "common-definitions.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common-definitions.schema.json#/$defs/nonEmpty"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "builtin": {
                "enum": [
                  "string",
                  "integer",
                  "decimal",
                  "boolean",
                  "date",
                  "datetime",
                  "uri",
                  "identifier"
                ]
              },
              "data_type": {
                "$ref": "common-definitions.schema.json#/$defs/id"
              },
              "enumeration": {
                "$ref": "common-definitions.schema.json#/$defs/id"
              }
            }
          },
          "cardinality": {
            "$ref": "common-definitions.schema.json#/$defs/cardinality"
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "extensions": {
            "$ref": "common-definitions.schema.json#/$defs/extensions"
          }
        }
      }
    },
    "property_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "properties"],
        "properties": {
          "id": {
            "$ref": "common-definitions.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common-definitions.schema.json#/$defs/nonEmpty"
          },
          "description": {
            "type": "string"
          },
          "properties": {
            "$ref": "common-definitions.schema.json#/$defs/refList"
          },
          "extensions": {
            "$ref": "common-definitions.schema.json#/$defs/extensions"
          }
        }
      }
    }
  }
}
