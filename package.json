{
  "name": "federated-architecture-analysis",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "format": "prettier --write src __tests__ e2e *.ts *.cjs scripts/*.mjs scripts/*.cjs",
    "format:check": "prettier --check src __tests__ e2e *.ts *.cjs scripts/*.mjs scripts/*.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
